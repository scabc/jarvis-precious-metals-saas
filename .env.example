# Jarvis 贵金属监控 SaaS - 环境变量模板
# 复制为 .env 后填入真实值，勿将 .env 提交到 Git

# ── Gmail 通知 ──────────────────────────────────────
SENDER_EMAIL=your@gmail.com
APP_PASSWORD=your-16-char-app-password

# ── Supabase ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── 商业数据 API ─────────────────────────────────────
# 极速数据 (https://www.jisuapi.com) - 金价全量接口
JISU_KEY=your-jisu-api-key

# ── 辅助数据源 (可选) ─────────────────────────────────
# ALAPI (https://v3.alapi.cn) - 品牌金饰价
ALAPI_TOKEN=your-alapi-token
