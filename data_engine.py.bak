"""
Jarvis 贵金属数据引擎 v2
多源聚合 + 交叉验证 + 银行真实点差计算

数据源：
  1. 东方财富（上金所实时行情） — 主源
  2. 新浪财经（国际贵金属）     — 校验源

银行点差：基于各银行公开公告维护，定期更新
"""

import requests
import json
import re
import time
import os
from datetime import datetime

# 国内数据源直连，不走代理
_NO_PROXY_SESSION = requests.Session()
_NO_PROXY_SESSION.trust_env = False  # 忽略环境变量中的代理设置

# ============================================================
# 银行真实点差表（元/克）
# 来源：各银行官网贵金属业务公告
# 格式：{ 银行: { 品种: (买入点差, 卖出点差) } }
# 买入点差为负（银行买入价 = 基准价 - 买入点差）
# 卖出点差为正（银行卖出价 = 基准价 + 卖出点差）
# 最后更新：2026-03-01
# ============================================================
BANK_SPREADS = {
    # 黄金点差单位：元/克，白银点差单位：元/千克
    "中国银行": {
        "黄金": (0.50, 0.50),
        "白银": (15.0, 15.0),
    },
    "工商银行": {
        "黄金": (0.40, 0.40),
        "白银": (12.0, 12.0),
    },
    "招商银行": {
        "黄金": (0.60, 0.60),
        "白银": (18.0, 18.0),
    },
    "建设银行": {
        "黄金": (0.45, 0.45),
        "白银": (14.0, 14.0),
    },
    "农业银行": {
        "黄金": (0.42, 0.42),
        "白银": (13.0, 13.0),
    },
    "交通银行": {
        "黄金": (0.50, 0.50),
        "白银": (15.0, 15.0),
    },
    "兴业银行": {
        "黄金": (0.55, 0.55),
        "白银": (16.0, 16.0),
    },
    "浦发银行": {
        "黄金": (0.52, 0.52),
        "白银": (15.0, 15.0),
    },
    "中信银行": {
        "黄金": (0.58, 0.58),
        "白银": (17.0, 17.0),
    },
    "民生银行": {
        "黄金": (0.60, 0.60),
        "白银": (18.0, 18.0),
    },
    "平安银行": {
        "黄金": (0.55, 0.55),
        "白银": (16.0, 16.0),
    },
    "光大银行": {
        "黄金": (0.58, 0.58),
        "白银": (17.0, 17.0),
    },
}

# 国际 → 国内换算系数（用于交叉验证，不参与实际报价）
# 注意：国内外市场存在天然价差（关税、VAT、交易时差等），
# 此系数仅用于粗略校验数据源是否异常，不追求精确
CNY_RATE = 6.80  # 近似汇率，偏保守以减少误报

# 黄金：国际美元/盎司 → 国内元/克（1盎司=31.1035克）
AU_INTL_TO_CNY = CNY_RATE / 31.1035

# 白银：国际美元/盎司 → 国内元/千克
AG_INTL_TO_CNY = CNY_RATE / 31.1035 * 1000

# 交叉验证偏差阈值
# 国内外价差通常在 3-8%，超过 10% 才认为数据源可能异常
CROSS_CHECK_THRESHOLD = 0.10


def fetch_eastmoney():
    """
    数据源1：东方财富 — 上金所实时行情
    返回: list of dict，每项含 code, name, price, change_pct
    """
    url = "https://push2.eastmoney.com/api/qt/clist/get"
    params = {
        "pn": "1", "pz": "50", "po": "1", "np": "1",
        "ut": "bd1d9ddb040897f3cf9c27f6f7426281",
        "fltt": "2", "invt": "2", "fid": "f3",
        "fs": "m:118,m:119,m:120,m:121",
        "fields": "f12,f14,f2,f3,f4"
    }
    for attempt in range(3):
        try:
            resp = _NO_PROXY_SESSION.get(url, params=params, timeout=15)
            data = resp.json()
            if data.get("rc") != 0 or not data.get("data"):
                return None
            results = []
            targets = {"AU9999", "AGTD", "黄金9999", "白银T+D", "铂金9995", "钯金9995"}
            for item in data["data"]["diff"]:
                if item.get("f14") in targets or item.get("f12") in targets:
                    results.append({
                        "code": item["f12"],
                        "name": item["f14"],
                        "price": float(item["f2"]) if item["f2"] != "-" else None,
                        "change_pct": float(item["f3"]) if item["f3"] != "-" else None,
                        "change_amt": float(item["f4"]) if item["f4"] != "-" else None,
                        "source": "eastmoney",
                    })
            return results if results else None
        except Exception as e:
            print(f"[东方财富] 第{attempt+1}次请求失败: {e}")
            if attempt < 2:
                time.sleep(2)
    return None


def fetch_sina():
    """
    数据源2：新浪财经 — 国际贵金属实时行情
    返回: dict { "XAU": price_usd, "XAG": price_usd }
    """
    url = "https://hq.sinajs.cn/list=hf_XAU,hf_XAG"
    headers = {
        "User-Agent": "Mozilla/5.0",
        "Referer": "https://finance.sina.com.cn/",
    }
    for attempt in range(3):
        try:
            resp = _NO_PROXY_SESSION.get(url, headers=headers, timeout=15)
            text = resp.text
            result = {}
            for line in text.strip().split("\n"):
                match = re.search(r'hq_str_hf_(\w+)="([^"]*)"', line)
                if match:
                    symbol = match.group(1)
                    fields = match.group(2).split(",")
                    if len(fields) >= 1 and fields[0]:
                        result[symbol] = float(fields[0])
            return result if result else None
        except Exception as e:
            print(f"[新浪] 第{attempt+1}次请求失败: {e}")
            if attempt < 2:
                time.sleep(2)
    return None


def cross_validate(eastmoney_data, sina_data):
    """
    交叉验证：用新浪国际金银价换算后与东方财富国内价比对
    分别验证黄金和白银，返回验证结果
    """
    if not eastmoney_data or not sina_data:
        return {"status": "incomplete", "details": "数据源不全"}

    # 提取国内基准价
    prices_cny = {}
    for item in eastmoney_data:
        if item["name"] in ("黄金9999", "AU9999") and item["price"]:
            prices_cny["AU"] = item["price"]
        elif item["name"] in ("白银T+D", "AGTD") and item["price"]:
            prices_cny["AG"] = item["price"]

    results = {}

    # 验证黄金
    xau = sina_data.get("XAU")
    au_cny = prices_cny.get("AU")
    if xau and au_cny:
        est = xau * AU_INTL_TO_CNY
        dev = abs(est - au_cny) / au_cny
        results["AU"] = {"estimated": round(est, 2), "actual": au_cny, "deviation": f"{dev:.2%}",
                         "status": "warning" if dev > CROSS_CHECK_THRESHOLD else "ok"}

    # 验证白银
    xag = sina_data.get("XAG")
    ag_cny = prices_cny.get("AG")
    if xag and ag_cny:
        est = xag * AG_INTL_TO_CNY
        dev = abs(est - ag_cny) / ag_cny
        results["AG"] = {"estimated": round(est, 2), "actual": ag_cny, "deviation": f"{dev:.2%}",
                         "status": "warning" if dev > CROSS_CHECK_THRESHOLD else "ok"}

    overall = "ok"
    for v in results.values():
        if v["status"] == "warning":
            overall = "warning"
            break

    return {"status": overall, "details": results}


def calc_bank_prices(base_prices):
    """
    基于上金所基准价 + 银行点差，计算各银行的买入/卖出价
    base_prices: list from fetch_eastmoney()
    返回: dict { 银行名: { 品种名: {bid, ask, base, spread_info} } }
    """
    # 提取基准价
    base_map = {}
    for item in base_prices:
        name = item["name"]
        if name in ("黄金9999", "AU9999") and item["price"]:
            base_map["黄金"] = item
        elif name in ("白银T+D", "AGTD") and item["price"]:
            base_map["白银"] = item

    bank_prices = {}
    for bank, spreads in BANK_SPREADS.items():
        bank_prices[bank] = {}
        for metal, (bid_spread, ask_spread) in spreads.items():
            base_item = base_map.get(metal)
            if not base_item or not base_item["price"]:
                continue
            base = base_item["price"]
            bank_prices[bank][metal] = {
                "base": base,
                "bid": round(base - bid_spread, 2),   # 银行买入价（你卖给银行）
                "ask": round(base + ask_spread, 2),    # 银行卖出价（你从银行买）
                "bid_spread": bid_spread,
                "ask_spread": ask_spread,
                "change_pct": base_item["change_pct"],
                "source_name": base_item["name"],
            }
    return bank_prices


def get_full_market_data():
    """
    主入口：获取完整市场数据
    返回: {
        "timestamp": ISO时间,
        "base_prices": [...],        # 上金所基准行情
        "intl_prices": {...},        # 国际金银价
        "bank_prices": {...},        # 各银行买卖价
        "cross_check": "ok/warning", # 交叉验证结果
        "sources": { 源: 状态 },
    }
    """
    ts = datetime.now().isoformat()

    # 并行获取两个数据源（这里串行，后续可改 threading）
    eastmoney = fetch_eastmoney()
    sina = fetch_sina()

    sources = {
        "eastmoney": "ok" if eastmoney else "failed",
        "sina": "ok" if sina else "failed",
    }

    # 交叉验证
    check = cross_validate(eastmoney, sina)

    # 计算银行价格
    bank_prices = calc_bank_prices(eastmoney) if eastmoney else {}

    return {
        "timestamp": ts,
        "base_prices": eastmoney or [],
        "intl_prices": sina or {},
        "bank_prices": bank_prices,
        "cross_check": check,
        "sources": sources,
    }


# ============================================================
# 兼容旧接口：gh_entry.py / monitor_service.py 调用
# ============================================================
def get_aggregated_data():
    """
    兼容旧版调用，返回东方财富的原始格式列表
    同时附加银行买卖价信息
    """
    full = get_full_market_data()
    base = full["base_prices"]

    # 给每条数据附加银行价格信息（以第一家银行为默认）
    for item in base:
        item["bank_prices"] = {}
        metal_key = None
        if item["name"] in ("黄金9999", "AU9999"):
            metal_key = "黄金"
        elif item["name"] in ("白银T+D", "AGTD"):
            metal_key = "白银"
        if metal_key:
            for bank, metals in full["bank_prices"].items():
                if metal_key in metals:
                    item["bank_prices"][bank] = metals[metal_key]

    return base


if __name__ == "__main__":
    data = get_full_market_data()
    print(json.dumps(data, indent=2, ensure_ascii=False, default=str))
